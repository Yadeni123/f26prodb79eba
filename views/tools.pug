extends layout

block content
  h1= title
  
  - let items = results

  div.container-fluid
    div.row
      each item, index in items
        div.col-sm-2(onclick=`buy(${index})`, style="cursor: pointer; border: 1px solid #ccc; padding: 10px; margin: 5px;")
          p Tool Type: #{item.tool_type}
          p Size: #{item.size}
          p Cost: #{item.cost}

  script.
    function buy(index) {
      alert(`You purchased item ${index}`);
    }