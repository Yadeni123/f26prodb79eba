extends layout

block content
  h1= title
  
  -
    let results = [
      { tool_name: "Hammer", weight: 2, material: "Steel" },
      { tool_name: "Screwdriver", weight: 1, material: "Plastic" },
      { tool_name: "Wrench", weight: 3, material: "Iron" }
    ]

  div.container-fluid
    div.row
      each item, index in results
        div.col-sm-2(onclick=`buy(${index})`, style="cursor: pointer; border: 1px solid #ccc; padding: 10px; margin: 5px;")
          p Name: #{item.tool_name}
          p Weight: #{item.weight}
          p Material: #{item.material}

  script.
    function buy(index) {
      alert(`You purchased item ${index}`);
    }