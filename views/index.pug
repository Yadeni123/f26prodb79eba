extends layout

block content
  h1= title
  p Welcome to #{title}
  
  button.btn.btn-secondary(type="button", onclick="reduce()") Press me
  
  div#use take some away

  script.
    let current = 11;
    let quantity = 2;
    function reduce() {
      current -= quantity;
      if (current < 0) {
        current = 0;
      }
      document.getElementById('use').innerHTML = `Reduced by ${quantity} to ${current}`;
    }

  br
  a(href="/tools") Go to Tools Search Results